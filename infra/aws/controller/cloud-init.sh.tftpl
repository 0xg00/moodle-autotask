#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/moodle-autotask-bootstrap.log | logger -t moodle-autotask-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git jq python3 python3-venv unzip

if ! command -v aws >/dev/null 2>&1; then
  curl --fail --silent --show-error --location \
    "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-2.36.19.zip" \
    --output /tmp/awscliv2.zip
  echo "545f9bf0cd58e0f30f3a9470d3c4e3387148006bf30f41fb3a4a167347be815f  /tmp/awscliv2.zip" \
    | sha256sum --check --strict
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

if command -v snap >/dev/null 2>&1 && snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap start amazon-ssm-agent
elif systemctl list-unit-files amazon-ssm-agent.service >/dev/null 2>&1; then
  systemctl enable --now amazon-ssm-agent
fi

if ! id --user ${project_name} >/dev/null 2>&1; then
  useradd --system --home-dir /var/lib/${project_name} --create-home --shell /usr/sbin/nologin ${project_name}
fi

install -d -o root -g root -m 0755 /opt/${project_name}
install -d -o ${project_name} -g ${project_name} -m 0750 /var/lib/${project_name}
install -d -o root -g ${project_name} -m 0750 /etc/${project_name}

cat >/usr/local/sbin/${project_name}-refresh-config <<'CONFIG_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 9>/run/lock/${project_name}-refresh.lock
flock -x 9
temporary_directory="$(mktemp -d "/etc/${project_name}/.refresh.XXXXXX")"
cleanup() {
  rm -rf "$temporary_directory"
}
trap cleanup EXIT
aws secretsmanager get-secret-value \
  --region "${region}" \
  --secret-id "${secret_arn}" \
  --query SecretString \
  --output text >"$temporary_directory/moodle-token.json"
aws secretsmanager get-secret-value \
  --region "${region}" \
  --secret-id "${telegram_secret_arn}" \
  --query SecretString \
  --output text >"$temporary_directory/telegram.json"
python3 - "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8-sig") as stream:
    moodle = json.load(stream)
if (
    not isinstance(moodle, dict)
    or set(moodle) - {"baseUrl", "token", "obtainedAt"}
    or not isinstance(moodle.get("baseUrl"), str)
    or not isinstance(moodle.get("token"), str)
    or ("obtainedAt" in moodle and not isinstance(moodle["obtainedAt"], str))
):
    raise SystemExit("Moodle secret has an invalid shape")

with open(sys.argv[2], encoding="utf-8-sig") as stream:
    telegram = json.load(stream)
if (
    not isinstance(telegram, dict)
    or set(telegram) != {"botToken", "chatId", "allowedUserId"}
    or not isinstance(telegram.get("botToken"), str)
    or not re.fullmatch(r"[1-9][0-9]{5,15}:[A-Za-z0-9_-]{30,100}", telegram["botToken"])
    or not isinstance(telegram.get("chatId"), int)
    or isinstance(telegram["chatId"], bool)
    or not 1 <= telegram["chatId"] < 2**63
    or not isinstance(telegram.get("allowedUserId"), int)
    or isinstance(telegram["allowedUserId"], bool)
    or not 1 <= telegram["allowedUserId"] < 2**63
):
    raise SystemExit("Telegram secret has an invalid shape")
PY
chown ${project_name}:${project_name} \
  "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json"
chmod 0600 "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json"
mv -f "$temporary_directory/moodle-token.json" /etc/${project_name}/moodle-token.json
mv -f "$temporary_directory/telegram.json" /etc/${project_name}/telegram.json
trap - EXIT
rmdir "$temporary_directory"
CONFIG_SCRIPT
chmod 0750 /usr/local/sbin/${project_name}-refresh-config

cat >/etc/systemd/system/${project_name}-scheduler.service <<'UNIT'
[Unit]
Description=Moodle Autotask notification scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=${project_name}
Group=${project_name}
WorkingDirectory=/var/lib/${project_name}
ExecStartPre=+/usr/local/sbin/${project_name}-refresh-config
ExecStart=/opt/${project_name}/current/venv/bin/moodle-autotask-scheduler run --state /var/lib/${project_name}/state.sqlite3 --token-file /etc/${project_name}/moodle-token.json --telegram-config-file /etc/${project_name}/telegram.json --approval-state /var/lib/${project_name}/approval.sqlite3 --interval-seconds ${scheduler_interval}
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/${project_name} /etc/${project_name} /run/lock
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/${project_name}-telegram.service <<'UNIT'
[Unit]
Description=Moodle Autotask Telegram approval receiver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=${project_name}
Group=${project_name}
WorkingDirectory=/var/lib/${project_name}
ExecStartPre=+/usr/local/sbin/${project_name}-refresh-config
ExecStart=/opt/${project_name}/current/venv/bin/moodle-autotask-telegram run --config-file /etc/${project_name}/telegram.json --state /var/lib/${project_name}/approval.sqlite3
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/${project_name} /etc/${project_name} /run/lock
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
touch /var/lib/${project_name}/bootstrap-complete
chown ${project_name}:${project_name} /var/lib/${project_name}/bootstrap-complete
