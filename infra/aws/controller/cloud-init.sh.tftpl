#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/moodle-autotask-bootstrap.log | logger -t moodle-autotask-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y bubblewrap ca-certificates curl git jq python3 python3-venv unzip

if ! command -v aws >/dev/null 2>&1; then
  curl --fail --silent --show-error --location \
    "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-2.36.19.zip" \
    --output /tmp/awscliv2.zip
  echo "545f9bf0cd58e0f30f3a9470d3c4e3387148006bf30f41fb3a4a167347be815f  /tmp/awscliv2.zip" \
    | sha256sum --check --strict
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

if command -v snap >/dev/null 2>&1 && snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap start amazon-ssm-agent
elif systemctl list-unit-files amazon-ssm-agent.service >/dev/null 2>&1; then
  systemctl enable --now amazon-ssm-agent
fi

if ! id --user ${project_name} >/dev/null 2>&1; then
  useradd --system --home-dir /var/lib/${project_name} --create-home --shell /usr/sbin/nologin ${project_name}
fi

install -d -o root -g root -m 0755 /opt/${project_name}
install -d -o ${project_name} -g ${project_name} -m 0750 /var/lib/${project_name}
install -d -o root -g ${project_name} -m 0750 /etc/${project_name}

python3 - '${scheduler_config_base64}' /etc/${project_name}/scheduler.json ${project_name} <<'PY'
import base64
import grp
import json
import os
import stat
import sys
import tempfile

encoded, target, group = sys.argv[1:]
def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key")
        result[key] = value
    return result
try:
    raw = base64.b64decode(encoded, validate=True)
    value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
except (UnicodeDecodeError, ValueError, json.JSONDecodeError) as error:
    raise SystemExit("invalid scheduler configuration") from error
keys = set(value) if isinstance(value, dict) else set()
courses = value.get("courseShortnames") if isinstance(value, dict) else None
all_courses = value.get("allCourses") if isinstance(value, dict) else None
cap = value.get("maxNewEventsPerCycle") if isinstance(value, dict) else None
if (
    (keys == {"courseShortnames", "maxNewEventsPerCycle"}
     and isinstance(courses, list) and courses
     and len(courses) <= 64
     and all(isinstance(item, str) and item and len(item.encode("utf-8")) <= 255 and not any(ord(char) <= 0x1f or ord(char) == 0x7f for char in item) for item in courses)
     and sum(len(item.encode("utf-8")) for item in courses) <= 2048
     and len(set(courses)) == len(courses))
    or (keys == {"allCourses", "maxNewEventsPerCycle"} and all_courses is True)
):
    pass
else:
    raise SystemExit("scheduler scope must be explicit and unambiguous")
if isinstance(cap, bool) or not isinstance(cap, int) or not 1 <= cap <= 100:
    raise SystemExit("invalid scheduler event cap")
if len(raw) > 16 * 1024:
    raise SystemExit("scheduler configuration is too large")
try:
    old = os.lstat(target)
except FileNotFoundError:
    old = None
if old is not None and (not stat.S_ISREG(old.st_mode) or stat.S_ISLNK(old.st_mode)):
    raise SystemExit("scheduler config target is unsafe")
directory = os.path.dirname(target)
parent = os.lstat(directory)
if (
    not stat.S_ISDIR(parent.st_mode)
    or stat.S_ISLNK(parent.st_mode)
    or parent.st_uid != 0
    or stat.S_IMODE(parent.st_mode) & 0o022
):
    raise SystemExit("scheduler config directory is unsafe")
fd, temporary = tempfile.mkstemp(prefix=".scheduler.", dir=directory)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    os.chown(temporary, 0, grp.getgrnam(group).gr_gid)
    os.chmod(temporary, 0o640)
    os.replace(temporary, target)
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY

cat >/usr/local/sbin/${project_name}-refresh-config <<'CONFIG_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 9>/run/lock/${project_name}-refresh.lock
flock -x 9
temporary_directory="$(mktemp -d "/etc/${project_name}/.refresh.XXXXXX")"
cleanup() {
  rm -rf "$temporary_directory"
}
trap cleanup EXIT
aws secretsmanager get-secret-value \
  --region "${region}" \
  --secret-id "${secret_arn}" \
  --query SecretString \
  --output text >"$temporary_directory/moodle-token.json"
aws secretsmanager get-secret-value \
  --region "${region}" \
  --secret-id "${telegram_secret_arn}" \
  --query SecretString \
  --output text >"$temporary_directory/telegram.json"
python3 - "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8-sig") as stream:
    moodle = json.load(stream)
if (
    not isinstance(moodle, dict)
    or set(moodle) - {"baseUrl", "token", "obtainedAt"}
    or not isinstance(moodle.get("baseUrl"), str)
    or not isinstance(moodle.get("token"), str)
    or ("obtainedAt" in moodle and not isinstance(moodle["obtainedAt"], str))
):
    raise SystemExit("Moodle secret has an invalid shape")

with open(sys.argv[2], encoding="utf-8-sig") as stream:
    telegram = json.load(stream)
if (
    not isinstance(telegram, dict)
    or set(telegram) != {"botToken", "chatId", "allowedUserId"}
    or not isinstance(telegram.get("botToken"), str)
    or not re.fullmatch(r"[1-9][0-9]{5,15}:[A-Za-z0-9_-]{30,100}", telegram["botToken"])
    or not isinstance(telegram.get("chatId"), int)
    or isinstance(telegram["chatId"], bool)
    or not 1 <= telegram["chatId"] < 2**63
    or not isinstance(telegram.get("allowedUserId"), int)
    or isinstance(telegram["allowedUserId"], bool)
    or not 1 <= telegram["allowedUserId"] < 2**63
):
    raise SystemExit("Telegram secret has an invalid shape")
PY
chown ${project_name}:${project_name} \
  "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json"
chmod 0600 "$temporary_directory/moodle-token.json" "$temporary_directory/telegram.json"
mv -f "$temporary_directory/moodle-token.json" /etc/${project_name}/moodle-token.json
mv -f "$temporary_directory/telegram.json" /etc/${project_name}/telegram.json
trap - EXIT
rmdir "$temporary_directory"
CONFIG_SCRIPT
chmod 0750 /usr/local/sbin/${project_name}-refresh-config

cat >/etc/systemd/system/${project_name}-scheduler.service <<'UNIT'
[Unit]
Description=Moodle Autotask notification scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=${project_name}
Group=${project_name}
WorkingDirectory=/var/lib/${project_name}
ExecStartPre=+/usr/local/sbin/${project_name}-refresh-config
ExecStart=/opt/${project_name}/current/venv/bin/moodle-autotask-scheduler run --state /var/lib/${project_name}/state.sqlite3 --token-file /etc/${project_name}/moodle-token.json --telegram-config-file /etc/${project_name}/telegram.json --approval-state /var/lib/${project_name}/approval.sqlite3 --interval-seconds ${scheduler_interval} --request-timeout-seconds 60 --scheduler-config-file /etc/${project_name}/scheduler.json
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/${project_name} /etc/${project_name} /run/lock
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/${project_name}-telegram.service <<'UNIT'
[Unit]
Description=Moodle Autotask Telegram approval receiver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=${project_name}
Group=${project_name}
WorkingDirectory=/var/lib/${project_name}
ExecStartPre=+/usr/local/sbin/${project_name}-refresh-config
ExecStart=/opt/${project_name}/current/venv/bin/moodle-autotask-telegram run --config-file /etc/${project_name}/telegram.json --state /var/lib/${project_name}/approval.sqlite3
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/${project_name} /etc/${project_name} /run/lock
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
UNIT

# Pre-created files are writable only through the owning service group.  The
# directory itself is root-owned and non-writable, so applications cannot add
# or replace heartbeat paths.
if ! id --user moodle-agent >/dev/null 2>&1; then
  useradd --system --home-dir /var/lib/moodle-agent --create-home --shell /usr/sbin/nologin moodle-agent
fi
install -d -o root -g root -m 0711 /run/${project_name}-health
install -o root -g ${project_name} -m 0620 /dev/null /run/${project_name}-health/scheduler
install -o root -g ${project_name} -m 0620 /dev/null /run/${project_name}-health/telegram
install -o root -g ${project_name} -m 0620 /dev/null /run/${project_name}-health/worker
install -o root -g moodle-agent -m 0620 /dev/null /run/${project_name}-health/agent

cat >/usr/local/sbin/${project_name}-health-publish <<'HEALTH'
#!/usr/bin/env bash
set -euo pipefail
root=/run/moodle-autotask-health
test -d "$root" && test ! -L "$root" && test "$(stat -c '%u:%a' "$root")" = 0:711
token="$(curl --fail --silent --show-error --connect-timeout 1 --max-time 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)"
instance="$(curl --fail --silent --show-error --connect-timeout 1 --max-time 2 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)"
[[ "$instance" =~ ^i-[0-9a-f]+$ ]]
metrics='['; aggregate=1
for item in scheduler:moodle-autotask telegram:moodle-autotask worker:moodle-autotask agent:moodle-agent; do
  service="$${item%%:*}"; group="$${item#*:}"; path="$root/$service"; healthy=1
  gid="$(getent group "$group" | cut -d: -f3)"; test -n "$gid"; test ! -L "$path"
  test "$(stat -c '%F:%u:%g:%a:%s' "$path")" = "regular empty file:0:$gid:620:0" || healthy=0
  ! systemctl is-enabled --quiet "moodle-autotask-$service.service" && ! systemctl is-active --quiet "moodle-autotask-$service.service" || healthy=0
  [ "$healthy" = 1 ] || aggregate=0
  metrics+="{\"MetricName\":\"ServiceStateMatchesExpectation\",\"Dimensions\":[{\"Name\":\"InstanceId\",\"Value\":\"$instance\"},{\"Name\":\"Service\",\"Value\":\"$service\"}],\"Value\":$healthy},"
done
metrics+="{\"MetricName\":\"ControllerStateMatchesExpectation\",\"Dimensions\":[{\"Name\":\"InstanceId\",\"Value\":\"$instance\"},{\"Name\":\"Service\",\"Value\":\"aggregate\"}],\"Value\":$aggregate},{\"MetricName\":\"ServicesExpectedRunning\",\"Dimensions\":[{\"Name\":\"InstanceId\",\"Value\":\"$instance\"},{\"Name\":\"Service\",\"Value\":\"aggregate\"}],\"Value\":0}]"
file="$(mktemp "$root/.metrics.XXXXXX")"; trap 'rm -f "$file"' EXIT
printf %s "$metrics" >"$file"
aws cloudwatch put-metric-data --region "${region}" --namespace MoodleAutotask/Controller --metric-data "file://$file"
HEALTH
chmod 0750 /usr/local/sbin/${project_name}-health-publish
cat >/etc/systemd/system/${project_name}-health.service <<'UNIT'
[Unit]
Description=Moodle Autotask controller health publisher
After=network-online.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/moodle-autotask-health-publish
UNIT
cat >/etc/systemd/system/${project_name}-health.timer <<'UNIT'
[Unit]
Description=Publish Moodle Autotask controller health every minute
[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=1s
Unit=moodle-autotask-health.service
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now ${project_name}-health.timer
touch /var/lib/${project_name}/bootstrap-complete
chown ${project_name}:${project_name} /var/lib/${project_name}/bootstrap-complete
