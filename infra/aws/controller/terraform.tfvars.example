expected_account_id      = "<AWS_ACCOUNT_ID>"
region                   = "eu-south-2"
controller_instance_type = "t3.small"
root_volume_size_gib     = 30

# Set exactly one scheduler scope before planning. This intentionally invalid default is rejected.
scheduler_course_shortnames       = []
scheduler_all_courses             = false
scheduler_max_new_events_per_cycle = 4

additional_tags = {
  Owner = "<OWNER>"
}
